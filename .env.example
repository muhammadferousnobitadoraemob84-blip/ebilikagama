# Database URL (PostgreSQL)
# For Vercel: Use Vercel Postgres or external PostgreSQL (Neon, Supabase)
# Example: postgresql://username:password@host:5432/dbname?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/ebilikagama"

# JWT Secret (change this in production!)
JWT_SECRET="your-secure-random-secret-here"
