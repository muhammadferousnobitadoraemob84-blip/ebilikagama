generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  fullName      String?
  passwordHash  String
  profilePhoto  String?   @db.Text
  role          String    @default("admin")
  active        Boolean   @default(true)
  // Server-side session revocation: embedded in the JWT at login, verified
  // against this column on every authenticated request. Incremented on
  // logout / password reset / disable to invalidate outstanding tokens.
  tokenVersion  Int       @default(1)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  visitorSessions VisitorSession[]
  visitorActivities VisitorActivity[]
}

model Channel {
  id              String   @id @default(cuid())
  name            String
  category        String
  twitchUsername  String
  thumbnail       String?  @db.Text
  description     String?  @db.Text
  liveStatus      String   @default("automatic")
  displayOrder    Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  programs        Program[]
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Program {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title       String
  date        String   // YYYY-MM-DD format
  startTime   String   // HH:mm format (24h)
  endTime     String   // HH:mm format (24h)
  description String? @db.Text
  thumbnail   String?  @db.Text
  status            String   @default("scheduled") // scheduled, live, finished
  youtubeBroadcastId String?  @db.Text // YouTube broadcast/video ID for imported streams
  youtubeUrl        String?  @db.Text // YouTube URL for imported streams
  // Recurring EPG (§10): the row is a TEMPLATE when recurrence != none.
  // Concrete dates are expanded server-side at read time (src/lib/epg.ts).
  recurrence        String?  // none | daily | weekly (null = legacy one-off)
  recurrenceWeekday Int?     // 0-6 (Sunday=0) for weekly templates
  recurrenceUntil   String?  // YYYY-MM-DD inclusive end of the recurrence
  parentId          String?  // template linkage (templates keep null)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([channelId, date])
  @@index([parentId])
  @@unique([youtubeBroadcastId], name: "idx_youtube_broadcast")
}

model Subscriber {
  id          String   @id @default(cuid())
  anonymousId String   @unique // Browser/device fingerprint hash
  createdAt   DateTime @default(now())
  active      Boolean  @default(true)
}

model Replay {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  videoUrl        String?  @db.Text // Legacy: URL to video
  googleDriveId   String?  @db.Text // Google Drive file ID
  googleDriveUrl  String?  @db.Text // Google Drive preview URL
  thumbnail       String?  @db.Text // URL to thumbnail
  duration        Int?     // Duration in seconds
  fileSize        BigInt?  // File size in bytes
  date            String   // Broadcast date YYYY-MM-DD
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Radio {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  thumbnail     String?  @db.Text
  twitchUsername String?
  category      String   @default("general")
  enabled       Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QuranAudio {
  id              String   @id @default(cuid())
  surahName       String
  surahNumber     Int
  ayahNumber      Int      @default(1)
  audioType       String   @default("ayah") // "ayah" or "full_surah"
  reciterName     String
  fileName        String
  fileSize        BigInt?
  duration        Int?     // Duration in seconds
  googleDriveId   String
  googleDriveUrl  String?
  status          String   @default("active")
  uploadedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([surahNumber, ayahNumber, reciterName])
  @@index([surahNumber, ayahNumber])
  @@index([reciterName])
}

// ── Visitor Records (admin-only analytics) ─────────────────────────────────
// One row per authenticated login. The client sends NO identity — every
// visitor attribute is derived server-side from the verified JWT session.
model VisitorSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt        DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  logoutAt       DateTime? // null = session ended / inactive (never claim logout)
  status         String    @default("active") // active | ended
  userAgent      String?   @db.Text
  activities     VisitorActivity[]

  @@index([userId, loginAt])
  @@index([lastActivityAt])
  @@index([status])
}

// One row per meaningful feature/action. NO sensitive content ever — only
// the fact that a feature/action happened, plus a small public metadata blob.
model VisitorActivity {
  id        String   @id @default(cuid())
  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String
  action    String
  page      String?
  metadata  String?  @db.Text // small JSON (names/titles only, never secrets)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([feature])
  @@index([action])
}

// ── Radio Proof-of-Play / Broadcast History (§4–§6) ────────────────────────
// One row per REAL radio track play, written from actual HTMLAudioElement
// playback events (started/ended/interrupted) — never from scheduler math.
// A track is only ever "completed" when the element truly finished it.
// Idempotency: `eventId` is unique — retries cannot duplicate a record.
model RadioPlayback {
  id             String    @id @default(cuid())
  eventId        String    @unique // idempotency key (timeline cycle-position based)
  trackId        String // Google Drive file ID — never audio bytes
  trackTitle     String
  startedAt      DateTime // actual playback start (wall clock)
  endedAt        DateTime? // actual playback end (ended/pause/azan/error)
  durationPlayed Float     @default(0) // seconds actually heard
  expectedDuration Float   @default(0) // playlist-declared duration (seconds)
  expectedStartAt  DateTime? // scheduler's planned start
  expectedEndAt    DateTime? // scheduler's planned end
  status        String    @default("playing") // playing|completed|interrupted|azan_interrupted|error|skipped
  interruptionReason String? // azan:<prayer> | ended | error:<msg> | page_closed | client:<n>
  azanInterrupted Boolean  @default(false)
  azanPrayer    String? // subuh|zohor|asar|maghrib|isyak when interrupted by azan
  sessionId     String? // browser broadcast instance id (diagnostics)
  clientId      String? // anonymous per-browser id (no personal data)
  createdAt     DateTime  @default(now())

  @@index([trackId, startedAt])
  @@index([startedAt])
  @@index([endedAt])
  @@index([status])
}

// ── Broadcast Timeline / Black Box (§6) — immutable expected-vs-actual log ─
model TimelineEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // idempotency: same event retried never duplicates
  kind        String // track_start|track_end|azan_start|azan_end|radio_resume
  label       String // track title or "Azan Maghrib"
  expectedAt  DateTime? // scheduler expectation (null = unscheduled/client event)
  actualAt    DateTime // what actually happened (wall clock)
  diffSeconds Float? // actual − expected, signed
  detail      String?  @db.Text // small JSON (trackId, prayer, status…)
  createdAt   DateTime @default(now())

  @@index([actualAt])
  @@index([kind, actualAt])
}

// ── Admin Audit Log (§9) — separate from Visitor Records, append-only ──────
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String? // null = system
  actorName   String? // display snapshot (username), role kept in metadata
  action      String // user.created | channel.updated | azan.test_mode_applied …
  targetType  String? // user | channel | program | setting | radio | backup …
  targetId    String?
  result      String   @default("success") // success | failure
  metadata    String?  @db.Text // SAFE metadata only (names, counts — never secrets)
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
}

// ── System Incidents (§19) — meaningful failures, deduped by signature ─────
model Incident {
  id           String   @id @default(cuid())
  signature    String   @unique // service+kind dedupe key
  service      String // radio|azan|drive|jakim|youtube|twitch|database|auth|audio|scheduler
  severity     String   @default("warning") // info|warning|error|critical
  message      String   @db.Text // safe, human-readable (no stack traces)
  status       String   @default("open") // open|investigating|resolved
  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())
  resolvedAt   DateTime?
  occurrences  Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, lastDetectedAt])
  @@index([service])
}

// ── Notification Center (§12) ──────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String    @db.Text
  targetAll Boolean   @default(true)
  targetRole String? // null=all-roles when targetAll, else user|admin
  userIds   String?   @db.Text // JSON array of User ids when targeted
  feature   String?   // optional feature/channel context tag
  createdBy String? // admin userId
  createdByName String?
  createdAt DateTime  @default(now())
  expiresAt DateTime? // null = no expiry
  active    Boolean   @default(true)
  reads     NotificationRead[]

  @@index([createdAt])
  @@index([active, expiresAt])
}

model NotificationRead {
  id             String @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
}

// ── Emergency Broadcast (§11) — highest-priority override, audit-logged ────
model EmergencyBroadcast {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  channelId   String? // target channel (null = radio/all)
  channelName String?
  mediaType   String    @default("program") // program|youtube|replay|text
  mediaRef    String? // youtube url / replay id / text content
  startsAt    DateTime
  endsAt      DateTime
  status      String    @default("scheduled") // scheduled|active|stopped|expired
  activatedAt DateTime?
  stoppedAt   DateTime?
  stoppedReason String?
  createdBy   String?
  createdByName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, startsAt])
  @@index([startsAt, endsAt])
}

// ── User Favorites (§15) — channels / radio / replay / quran ───────────────
model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  itemType  String // channel | radio | replay | quran
  itemId    String
  title     String? // display snapshot
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, itemType])
}
