generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  fullName      String?
  passwordHash  String
  profilePhoto  String?  @db.Text
  role          String   @default("admin")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Channel {
  id              String   @id @default(cuid())
  name            String
  category        String
  twitchUsername  String
  thumbnail       String?  @db.Text
  description     String?  @db.Text
  liveStatus      String   @default("automatic")
  displayOrder    Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  programs        Program[]
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model Program {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title       String
  date        String   // YYYY-MM-DD format
  startTime   String   // HH:mm format (24h)
  endTime     String   // HH:mm format (24h)
  description String? @db.Text
  thumbnail   String?  @db.Text
  status      String   @default("scheduled") // scheduled, live, finished
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channelId, date])
}

model Subscriber {
  id          String   @id @default(cuid())
  anonymousId String   @unique // Browser/device fingerprint hash
  createdAt   DateTime @default(now())
  active      Boolean  @default(true)
}

model Replay {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  videoUrl        String?  @db.Text // Legacy: URL to video
  googleDriveId   String?  @db.Text // Google Drive file ID
  googleDriveUrl  String?  @db.Text // Google Drive preview URL
  thumbnail       String?  @db.Text // URL to thumbnail
  duration        Int?     // Duration in seconds
  fileSize        BigInt?  // File size in bytes
  date            String   // Broadcast date YYYY-MM-DD
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Radio {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  streamUrl     String   @db.Text
  thumbnail     String?  @db.Text
  twitchUsername String?
  category      String   @default("general")
  enabled       Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
