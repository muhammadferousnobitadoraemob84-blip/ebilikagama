generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  fullName      String?
  passwordHash  String
  profilePhoto  String?   @db.Text
  role          String    @default("admin")
  active        Boolean   @default(true)
  // Server-side session revocation: embedded in the JWT at login, verified
  // against this column on every authenticated request. Incremented on
  // logout / password reset / disable to invalidate outstanding tokens.
  tokenVersion  Int       @default(1)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  visitorSessions VisitorSession[]
  visitorActivities VisitorActivity[]
}

model Channel {
  id              String   @id @default(cuid())
  name            String
  category        String
  twitchUsername  String
  thumbnail       String?  @db.Text
  description     String?  @db.Text
  liveStatus      String   @default("automatic")
  displayOrder    Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  programs        Program[]
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Program {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title       String
  date        String   // YYYY-MM-DD format
  startTime   String   // HH:mm format (24h)
  endTime     String   // HH:mm format (24h)
  description String? @db.Text
  thumbnail   String?  @db.Text
  status            String   @default("scheduled") // scheduled, live, finished
  youtubeBroadcastId String?  @db.Text // YouTube broadcast/video ID for imported streams
  youtubeUrl        String?  @db.Text // YouTube URL for imported streams
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([channelId, date])
  @@unique([youtubeBroadcastId], name: "idx_youtube_broadcast")
}

model Subscriber {
  id          String   @id @default(cuid())
  anonymousId String   @unique // Browser/device fingerprint hash
  createdAt   DateTime @default(now())
  active      Boolean  @default(true)
}

model Replay {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  videoUrl        String?  @db.Text // Legacy: URL to video
  googleDriveId   String?  @db.Text // Google Drive file ID
  googleDriveUrl  String?  @db.Text // Google Drive preview URL
  thumbnail       String?  @db.Text // URL to thumbnail
  duration        Int?     // Duration in seconds
  fileSize        BigInt?  // File size in bytes
  date            String   // Broadcast date YYYY-MM-DD
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Radio {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  thumbnail     String?  @db.Text
  twitchUsername String?
  category      String   @default("general")
  enabled       Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QuranAudio {
  id              String   @id @default(cuid())
  surahName       String
  surahNumber     Int
  ayahNumber      Int      @default(1)
  audioType       String   @default("ayah") // "ayah" or "full_surah"
  reciterName     String
  fileName        String
  fileSize        BigInt?
  duration        Int?     // Duration in seconds
  googleDriveId   String
  googleDriveUrl  String?
  status          String   @default("active")
  uploadedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([surahNumber, ayahNumber, reciterName])
  @@index([surahNumber, ayahNumber])
  @@index([reciterName])
}

// ── Visitor Records (admin-only analytics) ─────────────────────────────────
// One row per authenticated login. The client sends NO identity — every
// visitor attribute is derived server-side from the verified JWT session.
model VisitorSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt        DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  logoutAt       DateTime? // null = session ended / inactive (never claim logout)
  status         String    @default("active") // active | ended
  userAgent      String?   @db.Text
  activities     VisitorActivity[]

  @@index([userId, loginAt])
  @@index([lastActivityAt])
  @@index([status])
}

// One row per meaningful feature/action. NO sensitive content ever — only
// the fact that a feature/action happened, plus a small public metadata blob.
model VisitorActivity {
  id        String   @id @default(cuid())
  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String
  action    String
  page      String?
  metadata  String?  @db.Text // small JSON (names/titles only, never secrets)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([feature])
  @@index([action])
}
