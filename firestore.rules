rules_version = '2';

// eBilikAgamaTV Firestore security rules.
//
// ALL application data access flows through the Next.js server via the
// Firebase Admin SDK, which bypasses these rules entirely. The browser never
// talks to Firestore directly (no client SDK is shipped), so the safest
// posture is to deny all direct client access. Privileged operations (user
// management, settings, OAuth tokens) are server-only by construction.
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny every client read/write. Server (Admin SDK) access is
    // unaffected by rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
